// The provider below is the one thing Prisma will not read from an env var, so
// it is flipped by script rather than by configuration:
//
//   npm run db:postgres   # what deploys (Neon, Render, Supabase, any Postgres)
//   npm run db:sqlite     # zero-setup local dev, works offline
//
// Every model is written to be portable across both — no provider-specific
// types, and embeddings are stored as JSON text rather than a pgvector column.
// See README for the pgvector migration once the corpus outgrows in-app ranking.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// The assessment standard.
//
// These two models are a parsed *cache* of the markdown files in `criteria/`.
// The file is the source of truth and the thing HR edits; see criteria/README.md.
// Nothing here is ever generated by the model — the system reads the standard,
// it does not write it.
//
// A criteria set is immutable once created. Editing the file produces a new row
// (the hash differs), and interviews stay pointed at the row that was in force
// when they started, so "what standard was this person held to" stays answerable
// months later.
// ---------------------------------------------------------------------------

model CriteriaSet {
  id         String   @id @default(cuid())
  roleSlug   String // matches the filename: criteria/<roleSlug>.md
  roleTitle  String
  sector     String // only used for search filtering
  sourcePath String
  sourceHash String // content hash; a changed file becomes a new set
  version    Int      @default(1) // from the file's frontmatter, for humans
  parsedAt   DateTime @default(now())

  competencies CriteriaCompetency[]
  interviews   Interview[]
  assessments  Assessment[]

  @@unique([roleSlug, sourceHash])
  @@index([roleSlug])
}

model CriteriaCompetency {
  id            String      @id @default(cuid())
  criteriaSetId String
  criteriaSet   CriteriaSet @relation(fields: [criteriaSetId], references: [id], onDelete: Cascade)

  key          String // stable id; scores are recorded against this
  label        String
  description  String
  // Both halves are load-bearing: they feed the question generator *and* the
  // scorer. Dropping the weak half measurably degrades scoring quality.
  strongAnswer String
  weakAnswer   String
  priority     String // high | medium | low -> weight 3 | 2 | 1
  orderIndex   Int

  @@unique([criteriaSetId, key])
}

// One candidate, one competency, one source. Rows rather than JSON because the
// candidate list ranks and filters on these.
model CompetencyScore {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  competencyKey String
  label         String
  score         Float // 0-10
  confidence    String // low | medium | high
  evidenceQuote String // preserves the existing evidence discipline
  note          String
  source        String  @default("interview") // interview | homework
  // False means the interview never got to it. Excluded from the weighted mean
  // rather than scored zero — see src/lib/assess/scoring.ts.
  reached       Boolean @default(true)

  @@unique([assessmentId, competencyKey, source])
  @@index([assessmentId])
}

// ---------------------------------------------------------------------------
// Homework: a short practical task, generated from the role's criteria and this
// candidate's interview, aimed at the competencies the interview could not
// reach or left thinly evidenced.
//
// It exists to close coverage gaps, not to add a hurdle. A candidate whose
// interview covered everything well gets a task that says so and asks for
// little.
// ---------------------------------------------------------------------------

model Homework {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  criteriaSetId String?

  title            String
  brief            String // the task exactly as the candidate reads it
  rationale        String // why these competencies, shown to the candidate
  targetKeys       String // JSON string[] of competency keys
  // Per-target guidance for the grader, derived from the criteria file's own
  // strong/weak text. Written at generation time so grading is held to the same
  // standard the task was written against.
  expectations     String // JSON
  estimatedMinutes Int    @default(30)
  createdAt        DateTime @default(now())

  submission HomeworkSubmission?
}

model HomeworkSubmission {
  id         String   @id @default(cuid())
  homeworkId String   @unique
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  text        String
  charCount   Int
  submittedAt DateTime  @default(now())
  // Grading writes CompetencyScore rows with source = "homework" against the
  // interview's existing assessment, so one competency assessed twice merges
  // rather than counting twice. See src/lib/assess/scoring.ts.
  gradedAt    DateTime?
  graderNote  String?
  // Non-biometric, same discipline as the interview: paste events and timing,
  // never content surveillance.
  pasteCount  Int       @default(0)
}

model Candidate {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  location  String?
  createdAt DateTime @default(now())

  // Consent is per-purpose and recorded with a timestamp, because "did this
  // person agree to X" has to be answerable months later during an audit.
  consentInterview Boolean   @default(false)
  consentRecording Boolean   @default(false)
  consentLinkCheck Boolean   @default(false)
  consentedAt      DateTime?
  consentPolicyVer String? // which privacy text they actually saw

  resumes    Resume[]
  interviews Interview[]
  tags       CandidateTag[]
  profile    CandidateProfile?
}

model Resume {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  filename  String
  mimeType  String
  rawText   String
  // ExtractedResume (see src/lib/resume/schema.ts) serialised as JSON.
  extracted String
  createdAt DateTime @default(now())

  interviews Interview[]
  findings   VerificationFinding[]
}

// Internal-consistency and candidate-supplied-link checks. Deliberately NOT
// third-party background-check data: producing that for a hiring decision makes
// you a consumer reporting agency under FCRA.
model VerificationFinding {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  kind              String // timeline_gap | overlap | title_inflation | unverified_claim | link_ok | link_mismatch | credential_unconfirmed
  severity          String // info | low | medium | high
  field             String? // which resume field it concerns
  detail            String
  evidence          String? // JSON
  // Candidates get to see and rebut findings before a decision is made.
  candidateVisible  Boolean  @default(true)
  candidateResponse String?
  createdAt         DateTime @default(now())
}

model Interview {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resumeId    String
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  // The standard this interview was run against, frozen at the moment it
  // started. HR editing the criteria file afterwards does not move it.
  criteriaSetId String?
  criteriaSet   CriteriaSet? @relation(fields: [criteriaSetId], references: [id])
  roleSlug      String? // the criteria file this came from

  sector    String // engineering | finance | hr | sales | product | healthcare | legal | operations
  roleTitle String
  seniority String // junior | mid | senior | lead

  status         String    @default("in_progress") // in_progress | completed | abandoned
  // InterviewPlan JSON: the competencies to cover and resume claims to probe.
  plan           String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  // Set when a candidate who dropped out is offered their one retry. See
  // ABANDON_AFTER_MS in src/lib/interview/abandonment.ts.
  retryOfferedAt DateTime?

  turns           Turn[]
  integrityEvents IntegrityEvent[]
  assessment      Assessment?
  homework        Homework?
}

model Turn {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  idx  Int
  role String // interviewer | candidate
  text String

  // Which competency this question targets, and how deep the follow-up chain is.
  competency   String?
  questionType String? // resume_probe | behavioral | technical | logical | communication | hr_general | closing
  probeDepth   Int     @default(0)

  // Answer-side telemetry, used by the integrity model. All non-biometric.
  latencyMsFirstKey Int?
  latencyMsSubmit   Int?
  charCount         Int?

  // Set on candidate turns only: the engine appraises each answer at the moment
  // it decides the next question, and the final assessment reuses those rather
  // than re-reading the whole transcript from scratch.
  appraisal  String?
  // Stylometry result, present only on the rare answers that tripped the screen.
  stylometry String?

  createdAt DateTime @default(now())

  @@unique([interviewId, idx])
}

// Non-biometric integrity signals only. No face, gaze, or emotion inference:
// emotion recognition in an employment context is prohibited under EU AI Act
// Art. 5(1)(f), and face/eye biometrics trigger Illinois BIPA and Texas CUBI.
model IntegrityEvent {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  type    String // blur | focus | paste | copy | fullscreen_exit | second_voice | devtools | tab_hidden
  payload String? // JSON
  at      DateTime @default(now())
}

model Assessment {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  // The standard applied, so this stays interpretable after HR edits the file.
  criteriaSetId String?
  criteriaSet   CriteriaSet? @relation(fields: [criteriaSetId], references: [id])

  overallScore   Int // 0-100, weighted mean of competency scores — see src/lib/assess/scoring.ts
  recommendation String // strong_yes | yes | leaning_yes | no | insufficient_evidence
  summary        String

  // How many competencies the overall score actually rests on, and how many the
  // criteria file defines. Shown in the UI so a score from three of eight
  // competencies never reads like a score from all eight.
  competenciesCounted Int @default(0)
  competenciesTotal   Int @default(0)

  // Denormalised copy of the CompetencyScore rows, for the report views that
  // read the assessment alone. The rows are authoritative.
  competencies String
  scores       CompetencyScore[]
  strengths    String // JSON string[]
  concerns     String // JSON string[]

  // IntegrityReport JSON. Signals + a plain-language read, never a verdict.
  integrity    String
  // Where the interview contradicted or failed to support the resume.
  resumeDeltas String // JSON

  createdAt DateTime @default(now())
}

// Denormalised, searchable rollup. One row per candidate, rebuilt after each
// completed interview, so manager search never has to join across interviews.
model CandidateProfile {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  headline        String
  sector          String
  // The role this candidate was assessed for. A column rather than JSON because
  // the candidate list filters on it.
  roleSlug        String?
  roleTitle       String  @default("")
  seniority       String
  yearsExperience Float
  overallScore    Int
  recommendation  String
  summary         String

  // Free-text blob that the embedding is computed over.
  searchText   String
  // JSON number[] — cosine similarity is computed in-app. Swap for a pgvector
  // column when you outgrow a few thousand candidates (see README).
  embedding    String
  competencies String // CompetencyScore[] JSON, copied from the latest assessment

  updatedAt DateTime @updatedAt
}

model Tag {
  id         String         @id @default(cuid())
  label      String         @unique
  // skill | tool | domain | soft | sector | credential
  kind       String
  candidates CandidateTag[]
}

model CandidateTag {
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // 0-1. How well the interview actually supported this tag, as opposed to the
  // resume merely asserting it. This is the number that makes search useful.
  confidence Float
  // claimed | demonstrated | contradicted
  status     String  @default("claimed")
  evidence   String? // the answer excerpt that justified it

  @@id([candidateId, tagId])
  @@index([tagId])
}
