# Required — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Dev default (SQLite, zero setup). For Postgres see README "Moving to Postgres".
DATABASE_URL="file:./dev.db"

# Optional. If unset, a deterministic local lexical embedding is used instead,
# which is fine for a demo corpus but weaker at synonym matching.
VOYAGE_API_KEY=

# Manager-side auth for the demo. Change this.
MANAGER_PASSCODE=letmein
