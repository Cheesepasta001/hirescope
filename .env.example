# ---- required ----

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Local dev runs on SQLite with no database to install, and the committed
# schema already targets it — nothing to switch. The deploy flips itself to
# Postgres in render.yaml, so this line is only ever the local one.
DATABASE_URL="file:./dev.db"

# Gates the manager search and candidate reports. Change this.
MANAGER_PASSCODE=letmein

# ---- spend controls for a shared link ----

# Comma-separated invite codes required to start an interview. Leave unset to
# leave the demo open. A public ungated link is unbounded spend on your key:
# one full interview is roughly a dollar or two of Opus 5.
INVITE_CODES=

# Hard ceiling on interviews started per day, resets midnight UTC. 0 disables.
MAX_INTERVIEWS_PER_DAY=15

# ---- optional ----

# Real semantic search. Without it a local lexical fallback is used, which
# matches words rather than meaning.
VOYAGE_API_KEY=
